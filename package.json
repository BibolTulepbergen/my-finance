{
	"name": "my-finance",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "cross-env CLOUDFLARE_ENV=dev vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:generate:dev": "cross-env CLOUDFLARE_ENV=dev drizzle-kit generate",
		"db:migrate:dev": "wrangler d1 migrations apply my-finance-dev --remote --env dev",
		"db:migrate:prod": "wrangler d1 migrations apply my-finance-prod --remote",
		"android:build": "npm run build && npx cap sync android",
		"android:open": "npx cap open android",
		"android:run": "npm run android:build && npx cap run android"
	},
	"dependencies": {
		"@capacitor/android": "^8.0.0",
		"@capacitor/cli": "^8.0.0",
		"@capacitor/core": "^8.0.0",
		"@cloudflare/workers-types": "^4.20251218.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@hono/firebase-auth": "^1.4.2",
		"@hono/zod-validator": "^0.7.6",
		"@mui/icons-material": "^7.3.6",
		"@mui/material": "^7.3.6",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"firebase": "^12.7.0",
		"hono": "^4.11.1",
		"nanoid": "^5.1.6",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router-dom": "^7.11.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.17.1",
		"@eslint/js": "^9.33.0",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.0.0",
		"eslint": "^9.33.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.39.1",
		"vite": "^7.1.2",
		"wrangler": "^4.54.0"
	}
}
