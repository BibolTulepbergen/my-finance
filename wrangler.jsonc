/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-finance",
	"main": "worker/index.ts",
	"compatibility_date": "2025-12-10",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"PUBLIC_JWK_CACHE_KEY": "firebase-jwk-cache",
		"FIREBASE_PROJECT_ID": "my-finance-prod-b7487"
	},
	
	"triggers": {
		"crons": ["*/10 * * * *"]
	},
	
	"d1_databases": [
		{
			"binding": "DataBase",
			"database_name": "my-finance-prod",
			"database_id": "032b9b85-80ed-456b-91d7-66be4b4422fe",
			"migrations_dir": "migrations",
			"remote": true
		}
	],
	
	"kv_namespaces": [
		{
			"binding": "PUBLIC_JWK_CACHE_KV",
			"id": "8899fc017a4a491db9ae7b84edaa7c7e",
			"remote": true
		}
	],
	"env": {
		"dev": {
			"name": "my-finance-dev",
			"compatibility_flags": ["nodejs_compat"],
			"d1_databases": [
				{
					"binding": "DataBase",
					"database_name": "my-finance-dev",
					"database_id": "77fcc790-099b-4d01-aa83-b318d43754e4",
					"migrations_dir": "migrations",
					"remote": true
				}
			],
			"vars": {
				"PUBLIC_JWK_CACHE_KEY": "firebase-jwk-cache",
				"FIREBASE_PROJECT_ID": "my-finance-dev-3d62a"
			},
			"kv_namespaces": [
				{
					"binding": "PUBLIC_JWK_CACHE_KV",
					"id": "06cbb4fc990c430f94099e088b956782",
					"remote": true
				}
			]
		}
	}
}